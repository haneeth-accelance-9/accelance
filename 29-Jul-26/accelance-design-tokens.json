{
  "meta": {
    "name": "Accelance Design Tokens",
    "version": "1.0.0",
    "source": "Figma reference stack (source of truth), cross-verified against accelance_logo.png and live accelance.io screenshots",
    "notes": "Values marked 'proposed' are not yet confirmed by Accelance and should be reviewed before production use."
  },
  "color": {
    "azureBlue": {
      "700": "#011224",
      "600": "#032F52",
      "500": "#075085",
